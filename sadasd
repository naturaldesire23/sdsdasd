Internal.Tab.IndicatorPosition = function(window, tab)
    local pos = Internal.Layout.TabPad
    for _, t in ipairs(window.Tabs) do
        if t == tab then
            return UDim2.fromOffset(Internal.Layout.TabPad, pos)
        end
        pos = pos + Internal.Layout.TabH + Internal.Layout.TabGap
    end
    return UDim2.fromOffset(Internal.Layout.TabPad, Internal.Layout.TabPad)
end

Internal.Tab.SlideIndicator = function(window, tab, animated)
    local indicator = window.Indicator
    if not indicator or not tab then
        return
    end
    local pos = Internal.Tab.IndicatorPosition(window, tab)
    indicator.Visible = true
    indicator.Size = UDim2.new(1, -(Internal.Layout.TabPad * 2), 0, Internal.Layout.TabH)

    if window.TabIndicatorTween then
        window.TabIndicatorTween:Cancel()
        window.TabIndicatorTween = nil
    end

    if not animated then
        indicator.Position = pos
        return
    end
    window.TabIndicatorTween = Internal.Util.Tween(indicator, { Position = pos }, Internal.Layout.TabIndicatorSlide)
end

Internal.Tab.Create = function(window, config)
    local tab = {
        Window = window,
        Title = config.Title or "Tab",
        Modules = {},
        Index = #window.Tabs + 1,
        Internal = config.Internal == true,
    }

    local button = Internal.Util.New("TextButton", {
        Name = "Tab",
        Text = "",
        AutoButtonColor = false,
        Size = UDim2.new(1, 0, 0, Internal.Layout.TabH),
        BackgroundTransparency = 1,
        ZIndex = 2,
        LayoutOrder = tab.Internal and 0 or tab.Index,
        Parent = window.TabHolder,
    })
    tab.Button = button

    local frame = Internal.Util.New("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Parent = button,
    }, { Internal.Util.FlexRow(9), Internal.Util.Padding(0, 0, 12, 12) })

    local icon
    if config.Icon then
        icon = Internal.Util.Image({
            Image = config.Icon,
            Size = UDim2.fromOffset(15, 15),
            ImageTransparency = 0.35,
            ColorKey = "SubText",
            LayoutOrder = 1,
            Parent = frame,
        })
    end

    local label = Internal.Util.Label({
        Text = tab.Title,
        TextSize = 12.5,
        Weight = Internal.Layout.Weight.Medium,
        ColorKey = "SubText",
        AutomaticSize = Enum.AutomaticSize.X,
        Size = UDim2.new(0, 0, 1, 0),
        LayoutOrder = 2,
        Parent = frame,
    })

    local page, scroller, leftCol, rightCol = Internal.Page.Create(window.Content)
    tab.Page = page
    tab.Scroller = scroller
    tab.Left = leftCol
    tab.Right = rightCol

    tab.Select = function(_, animated)
        if window.SearchBox and window.SearchBox.Text ~= "" then
            window.SearchBox.Text = ""
        end
        if window.ActiveTab == tab then
            return
        end
        local oldTab = window.ActiveTab
        window.ActiveTab = tab
        local useAnim = animated ~= false

        if oldTab then
            Internal.Util.Tween(oldTab.Page, { GroupTransparency = 1 }, useAnim and 0.16 or 0)
            task.delay(useAnim and 0.16 or 0, function()
                if window.ActiveTab ~= oldTab then
                    oldTab.Page.Visible = false
                end
            end)
            Internal.Util.Tween(oldTab.Label, { TextColor3 = palette.SubText }, useAnim and 0.2 or 0)
            if oldTab.Glyph then
                Internal.Util.Tween(oldTab.Glyph, { ImageColor3 = palette.SubText, ImageTransparency = 0.35 }, useAnim and 0.2 or 0)
            end
        end

        page.Visible = true
        if useAnim then
            page.GroupTransparency = 1
            page.Position = UDim2.fromOffset(0, 8)
            Internal.Util.Tween(page, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) }, 0.2)
            Internal.Util.Tween(label, { TextColor3 = palette.Text }, 0.22)
            if icon then
                Internal.Util.Tween(icon, { ImageColor3 = palette.Accent, ImageTransparency = 0 }, 0.22)
            end
        else
            page.GroupTransparency = 0
            page.Position = UDim2.fromOffset(0, 0)
            label.TextColor3 = palette.Text
            if icon then
                icon.ImageColor3 = palette.Accent
                icon.ImageTransparency = 0
            end
        end

        tab:SyncIndicator(useAnim and oldTab ~= nil)
    end

    tab.SyncIndicator = function(_, animated)
        if window.ActiveTab ~= tab then
            return
        end
        Internal.Tab.SlideIndicator(window, tab, animated == true)
    end

    tab.Module = function(_, modConfig)
        return Internal.Module.Create(tab, modConfig or {})
    end

    tab.Text = label
    tab.Glyph = icon

    Internal.Util.Connect(button.MouseButton1Click, function()
        tab:Select()
    end)

    Internal.Util.Hover(button, function()
        if window.ActiveTab ~= tab then
            Internal.Util.Tween(label, { TextColor3 = palette.Text }, 0.16)
            if icon then
                Internal.Util.Tween(icon, { ImageTransparency = 0.1 }, 0.16)
            end
        end
    end, function()
        if window.ActiveTab ~= tab then
            Internal.Util.Tween(label, { TextColor3 = palette.SubText }, 0.2)
            if icon then
                Internal.Util.Tween(icon, { ImageTransparency = 0.35 }, 0.2)
            end
        end
    end)

    table.insert(window.Tabs, tab)
    if not tab.Internal and (window.ActiveTab == nil or window.ActiveTab.Internal) then
        tab:Select(true)
    end

    task.defer(function()
        if window.ActiveTab == tab then
            tab:SyncIndicator(false)
        end
    end)

    return tab
end

local function setupMediaSystem()
    local media = {
        Seq = 0,
        Active = false,
        Opacity = 0.45,
    }

    function media.ApiBase()
        local url = tostring(getgenv and getgenv().ZENTHRA_SHEET_API or ZenthraUI.SheetApiUrl or ""):gsub("^%s+", ""):gsub("%s+$", ""):gsub("/+$", "")
        if not url:match("^https?://") then
            return nil
        end
        return url
    end

    local function getMediaFolder()
        return tostring(ZenthraUI.MediaFolder or "Zenthra/backgrounds")
    end

    local function hasFilesystem()
        return Env.Filesystem and typeof(listfiles) == "function"
    end

    local function ensureFolder()
        if not Env.Filesystem then
            return false
        end
        local folder = getMediaFolder()
        local root = folder:match("^([^/\\]+)")
        pcall(function()
            if root and not isfolder(root) then
                makefolder(root)
            end
            if not isfolder(folder) then
                makefolder(folder)
            end
        end)
        return isfolder(folder)
    end

    local function urlEncode(str)
        if type(str) ~= "string" then
            return ""
        end
        return (str:gsub("[^%w%-_%.~]", function(c)
            return string.format("%%%02X", string.byte(c))
        end))
    end

    local function getRequest()
        if typeof(request) == "function" then
            return request
        end
        if typeof(http_request) == "function" then
            return http_request
        end
        if syn and typeof(syn.request) == "function" then
            return syn.request
        end
        return nil
    end

    local function getAsset(path)
        if typeof(getcustomasset) == "function" then
            return getcustomasset(path)
        end
        if typeof(getsynasset) == "function" then
            return getsynasset(path)
        end
        return nil
    end

    local function base64Decode(str)
        if crypt and typeof(crypt.base64decode) == "function" then
            return crypt.base64decode(str)
        end
        if crypt and crypt.base64 and typeof(crypt.base64.decode) == "function" then
            return crypt.base64.decode(str)
        end

        local lookup = {}
        for i = 1, 64 do
            lookup[string.byte("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/", i)] = i - 1
        end

        str = str:gsub("[^%w%+/=]", "")
        local out = {}
        local pos = 1
        local idx = 1

        while pos <= #str do
            local a = lookup[string.byte(str, pos)]
            local b = lookup[string.byte(str, pos + 1)]
            if not a or not b then
                break
            end
            local c = string.byte(str, pos + 2) and lookup[string.byte(str, pos + 2)]
            local d = string.byte(str, pos + 3) and lookup[string.byte(str, pos + 3)]

            out[idx] = string.char(a * 4 + math.floor(b / 16))
            idx = idx + 1
            if c then
                out[idx] = string.char(b % 16 * 16 + math.floor(c / 4))
                idx = idx + 1
                if d then
                    out[idx] = string.char(c % 4 * 64 + d)
                    idx = idx + 1
                end
            end
            pos = pos + 4
        end
        return table.concat(out)
    end

    local function base64Encode(str)
        if crypt and typeof(crypt.base64encode) == "function" then
            return crypt.base64encode(str)
        end
        if crypt and crypt.base64 and typeof(crypt.base64.encode) == "function" then
            return crypt.base64.encode(str)
        end

        local out = {}
        local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
        for i = 1, #str, 3 do
            local a, b, c = string.byte(str, i, i + 2)
            local n = a * 65536 + (b or 0) * 256 + (c or 0)
            out[#out + 1] = alphabet:sub(math.floor(n / 262144) % 64 + 1, math.floor(n / 262144) % 64 + 1)
            out[#out + 1] = alphabet:sub(math.floor(n / 4096) % 64 + 1, math.floor(n / 4096) % 64 + 1)
            out[#out + 1] = b and alphabet:sub(math.floor(n / 64) % 64 + 1, math.floor(n / 64) % 64 + 1) or "="
            out[#out + 1] = c and alphabet:sub(n % 64 + 1, n % 64 + 1) or "="
        end
        return table.concat(out)
    end

    local function loadAsset(path)
        local fullPath = getMediaFolder() .. "/" .. path
        local ok, result = pcall(readfile, fullPath)
        if not ok or type(result) ~= "string" or #result == 0 then
            return getAsset(fullPath)
        end
        local hash = #result % 16777213
        for i = 1, #result, math.max(1, math.floor(#result / 64)) do
            hash = (hash * 31 + result:byte(i)) % 16777213
        end
        local cacheDir = getMediaFolder() .. "/.cache"
        local cachePath = cacheDir .. "/" .. string.format("%x", hash) .. "." .. (path:match("%.(%w+)$") or "png")
        return getAsset(pcall(function()
            if not isfolder(cacheDir) then
                makefolder(cacheDir)
            end
            if not isfile(cachePath) then
                writefile(cachePath, result)
            end
        end) and cachePath or fullPath)
    end

    local function parseApiResponse(raw)
        local ok, result = pcall(function()
            return Http:JSONDecode(raw)
        end)
        if not ok or type(result) ~= "table" then
            return nil, "Bad API response"
        end
        if not result.ok then
            return nil, tostring(result.error or "API error")
        end
        if not result.multi or type(result.images) ~= "table" or #result.images == 0 then
            return nil, "API returned no pages"
        end
        local pages = {}
        for i, img in ipairs(result.images) do
            local decoded = base64Decode(img)
            if type(decoded) ~= "string" or #decoded == 0 then
                return nil, "Could not decode page " .. i
            end
            pages[i] = decoded
        end
        return pages, {
            cols = result.cols,
            cellW = result.cellW,
            cellH = result.cellH,
            count = result.count,
            counts = result.counts,
            delayMs = result.delayMs or 100,
            ext = (result.ext == "jpg" or result.ext == "png") and result.ext or "jpg",
        }
    end

    local function httpRequest(url, method, headers, body)
        local req = getRequest()
        if req then
            local ok, result = pcall(req, { Url = url, Method = method or "GET", Headers = headers, Body = body })
            if ok and type(result) == "table" and type(result.Body) == "string" and #result.Body > 0 then
                return result.Body, result.StatusCode or result.Status
            end
        end
        if (method or "GET") == "GET" and not body then
            local ok, result = pcall(function()
                return game:HttpGet(url, true)
            end)
            if ok and type(result) == "string" and result ~= "" then
                return result, 200
            end
        end
        return nil, nil
    end

    local function fetchRawData(url)
        local body, status = httpRequest(url, "GET", {
            ["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36",
            Accept = "image/avif,image/webp,image/apng,image/*,video/*,*/*;q=0.8",
            Referer = (url:match("^(https?://[^/]+)") or "") .. "/",
        })
        if type(body) ~= "string" or #body < 32 then
            return nil
        end
        if status and status ~= 200 then
            return nil
        end
        local sniff = body:sub(1, 200):lower()
        if sniff:find("<!doctype", 1, true) or sniff:find("<html", 1, true) or sniff:find("just a moment", 1, true) then
            return nil
        end
        return body
    end

    local function detectFormat(raw)
        if type(raw) ~= "string" or #raw < 12 then
            return nil
        end
        if raw:sub(1, 8) == "\137PNG\r\n\26\n" then
            return "png"
        end
        if raw:byte(1) == 0xFF and raw:byte(2) == 0xD8 then
            return "jpg"
        end
        if raw:sub(1, 4) == "GIF8" then
            return "gif"
        end
        if raw:sub(1, 4) == "RIFF" and raw:sub(9, 12) == "WEBP" then
            return "webp"
        end
        if raw:sub(1, 4) == "ftyp" then
            local brand = raw:sub(5, 12):lower()
            if brand:find("avif", 1, true) or brand:find("avis", 1, true) then
                return "avif"
            end
            if brand:find("heic", 1, true) or brand:find("heif", 1, true) then
                return "heic"
            end
            if brand:find("mp4", 1, true) or brand:find("isom", 1, true) then
                return "mp4"
            end
        end
        if raw:byte(1) == 0x1A and raw:byte(2) == 0x45 then
            return "webm"
        end
        return nil
    end

    local function deleteMediaFile(name)
        local validExts = { "png", "jpg", "jpeg", "webp", "bmp", "gif", "mp4", "webm", "mov" }
        for _, ext in ipairs(validExts) do
            pcall(delfile, getMediaFolder() .. "/" .. name .. "." .. ext)
            pcall(delfile, getMediaFolder() .. "/" .. name .. "." .. ext .. ".json")
            local i = 2
            while typeof(isfile) == "function" and isfile(getMediaFolder() .. "/" .. name .. ".p" .. i .. "." .. ext) do
                pcall(delfile, getMediaFolder() .. "/" .. name .. ".p" .. i .. "." .. ext)
                i = i + 1
            end
        end
    end

    local function saveMediaFile(raw, ext, name)
        name = tostring(name or ""):gsub("[%\\/:%*%?\"<>|]", ""):gsub("^%s+", ""):gsub("%s+$", ""):gsub("%.%w+$", "")
        if name == "" then
            name = "media_" .. tostring(os.time())
        end
        local filename = name .. "." .. ext
        if not pcall(function()
            ensureFolder()
            deleteMediaFile(name)
            writefile(getMediaFolder() .. "/" .. filename, raw)
        end) then
            return false, "Could not write the file"
        end
        return true, filename
    end

    local function convertViaApi(raw, ext, name)
        local api = media.ApiBase()
        if not api then
            return nil, "API URL must start with http"
        end
        local encoded = base64Encode(raw)
        if type(encoded) ~= "string" or encoded == "" then
            return nil, "Could not encode media for upload"
        end
        local json = Http:JSONEncode({ data = encoded, name = name })
        local body = httpRequest(api .. "/sheet?multi=1&quality=original&fmt=png&format=json", "POST", { ["Content-Type"] = "application/json" }, json)
        if not body then
            return nil, "Upload to API failed"
        end
        return parseApiResponse(body)
    end

    function media.List()
        local list = { "None" }
        if not hasFilesystem() or not isfolder(getMediaFolder()) then
            return list
        end
        local ok, files = pcall(listfiles, getMediaFolder())
        if not ok or type(files) ~= "table" then
            return list
        end
        for _, file in ipairs(files) do
            local filename = file:match("([^/\\]+)$")
            if filename and not filename:lower():match("%.p%d+%.%w+$") and not filename:lower():match("%.json$") and filename ~= ".cache" then
                local ext = filename:match("%.(%w+)$")
                if ext then
                    ext = ext:lower()
                    if ext == "png" or ext == "jpg" or ext == "jpeg" or ext == "webp" or ext == "bmp" or ext == "gif" or ext == "mp4" or ext == "webm" or ext == "mov" then
                        table.insert(list, filename)
                    end
                end
            end
        end
        return list
    end

    function media.Save(url, name)
        if not hasFilesystem() then
            return false, "Executor does not support file system"
        end
        local raw = fetchRawData(url)
        local fmt = raw and detectFormat(raw)
        local staticFormats = { png = true, jpg = true, jpeg = true, webp = true, bmp = true }
        if raw and fmt and staticFormats[fmt] then
            return saveMediaFile(raw, fmt == "jpeg" and "jpg" or fmt, name)
        end

        if raw and (fmt == "avif" or fmt == "heic") then
            local pages, metadata = convertViaApi(raw, fmt, "upload_" .. fmt)
            if not pages then
                return false, metadata
            end
            name = tostring(name or ""):gsub("[%\\/:%*%?\"<>|]", ""):gsub("^%s+", ""):gsub("%s+$", ""):gsub("%.%w+$", "")
            if name == "" then
                name = "media_" .. tostring(os.time())
            end
            local filename = name .. "." .. ((metadata.ext == "png" or metadata.ext == "jpg") and metadata.ext or "jpg")
            if not pcall(function()
                ensureFolder()
                deleteMediaFile(name)
                writefile(getMediaFolder() .. "/" .. filename, pages[1])
            end) then
                return false, "Could not write the file"
            end
            return true, filename
        end

        local api = media.ApiBase()
        if not api then
            return false, "API URL must start with http"
        end
        local body = httpRequest(api .. "/sheet?url=" .. urlEncode(url) .. "&multi=1&quality=original&fmt=jpg&format=json", "GET")
        if not body then
            return false, "Request failed, is the API up?"
        end
        local pages, metadata = parseApiResponse(body)
        if not pages then
            return false, metadata
        end

        name = tostring(name or ""):gsub("[%\\/:%*%?\"<>|]", ""):gsub("^%s+", ""):gsub("%s+$", ""):gsub("%.%w+$", "")
        if name == "" then
            name = "media_" .. tostring(os.time())
        end

        local isSingle = #pages == 1 and (metadata.count or 1) <= 1
        if isSingle then
            local filename = name .. "." .. ((metadata.ext == "png" or metadata.ext == "jpg") and metadata.ext or "jpg")
            if not pcall(function()
                ensureFolder()
                deleteMediaFile(name)
                writefile(getMediaFolder() .. "/" .. filename, pages[1])
            end) then
                return false, "Could not write the file"
            end
            return true, filename
        end

        local files = { name .. "." .. metadata.ext }
        for i = 2, #pages do
            files[i] = name .. ".p" .. i .. "." .. metadata.ext
        end
        if not pcall(function()
            ensureFolder()
            deleteMediaFile(name)
            for i, page in ipairs(pages) do
                writefile(getMediaFolder() .. "/" .. files[i], page)
            end
            writefile(getMediaFolder() .. "/" .. files[1] .. ".json", Http:JSONEncode({
                cols = metadata.cols,
                cellW = metadata.cellW,
                cellH = metadata.cellH,
                count = metadata.count,
                counts = metadata.counts,
                delayMs = metadata.delayMs,
                pages = files,
                ext = metadata.ext,
            }))
        end) then
            return false, "Could not write the files"
        end
        return true, files[1]
    end

    function media.Stop(window)
        media.Seq = media.Seq + 1
        media.Active = false
        local win = window or ZenthraUI.Windows[1]
        if not win then
            return
        end
        local canvas = win.BgCanvas
        local wallpaper = win.Wallpaper
        local video = win.BgVideo

        if video then
            pcall(function()
                video:Pause()
            end)
            video.Visible = false
            pcall(function()
                video.Video = ""
            end)
        end
        if wallpaper then
            wallpaper.Image = ""
            wallpaper.ImageTransparency = 1
            wallpaper.ImageRectOffset = Vector2.zero
            wallpaper.ImageRectSize = Vector2.zero
            local preload = wallpaper:FindFirstChild("Preload")
            if preload then
                preload:Destroy()
            end
        end
        if canvas then
            canvas.Visible = false
        end
    end

    function media.SetOpacity(opacity, window)
        media.Opacity = math.clamp(tonumber(opacity) or 0.45, 0, 1)
        local win = window or ZenthraUI.Windows[1]
        if not win then
            return
        end
        local canvas = win.BgCanvas
        local wallpaper = win.Wallpaper
        local video = win.BgVideo
        if not canvas then
            return
        end
        if wallpaper and wallpaper.Image ~= "" then
            wallpaper.ImageTransparency = 1 - media.Opacity
        end
        canvas.GroupTransparency = video and video.Visible and 1 - media.Opacity or 0
        if media.Active then
            canvas.Visible = media.Opacity > 0.004
        end
    end

    function media.ShowStatic(image, window)
        media.Stop(window)
        local win = window or ZenthraUI.Windows[1]
        if not win or not win.BgCanvas or not win.Wallpaper or type(image) ~= "string" or image == "" then
            return
        end
        win.BgCanvas.Visible = true
        win.Wallpaper.Visible = true
        win.Wallpaper.ImageRectOffset = Vector2.zero
        win.Wallpaper.ImageRectSize = Vector2.zero
        win.Wallpaper.Image = image
        win.Wallpaper.ScaleType = Enum.ScaleType.Stretch
        media.Active = true
        media.SetOpacity(media.Opacity, win)
    end

    function media.PlayPages(assets, metadata, window)
        media.Stop(window)
        media.Seq = media.Seq + 1
        local seq = media.Seq
        local win = window or ZenthraUI.Windows[1]
        if not win or not win.BgCanvas or not win.Wallpaper or not metadata or (metadata.count or 0) < 1 then
            return
        end

        local cellW = metadata.cellW
        local cellH = metadata.cellH
        local cols = metadata.cols
        local frames = {}
        local idx = 0

        for i, asset in ipairs(assets) do
            local counts = metadata.counts and metadata.counts[i] or metadata.count
            for i2 = 0, counts - 1 do
                idx = idx + 1
                frames[idx] = { asset, i2 % cols * cellW, math.floor(i2 / cols) * cellH }
                if metadata.count <= idx then
                    break
                end
            end
            if metadata.count <= idx then
                break
            end
        end

        if idx == 0 then
            return
        end

        local folder = Instance.new("Folder")
        folder.Name = "Preload"
        folder.Parent = win.Wallpaper
        local preloadMap = {}
        for _, asset in ipairs(assets) do
            local img = Instance.new("ImageLabel")
            img.Size = UDim2.fromOffset(1, 1)
            img.BackgroundTransparency = 1
            img.ImageTransparency = 0.996
            img.Image = asset
            img.Parent = folder
            preloadMap[asset] = img
        end

        win.BgCanvas.Visible = true
        win.Wallpaper.Visible = true
        win.Wallpaper.Image = frames[1][1]
        win.Wallpaper.ImageRectSize = Vector2.new(cellW, cellH)
        win.Wallpaper.ImageRectOffset = Vector2.new(frames[1][2], frames[1][3])
        win.Wallpaper.ScaleType = Enum.ScaleType.Stretch
        media.Active = true
        media.SetOpacity(media.Opacity, win)

        if idx ~= 1 then
            local delay = math.max(0.016666666666666666, (tonumber(metadata.delayMs) or 100) / 1000)
            task.spawn(function()
                local first = frames[1][1]
                local frameIdx = 1
                while true do
                    if seq ~= media.Seq or not win.Wallpaper.Parent then
                        break
                    end
                    task.wait(delay)
                    if seq ~= media.Seq or not win.Wallpaper.Parent then
                        break
                    end
                    frameIdx = frameIdx % idx + 1
                    local frame = frames[frameIdx]
                    local preload = preloadMap[frame[1]]
                    if frame[1] ~= first and preload and not preload.IsLoaded then
                        local timeout = os.clock() + 3
                        while seq == media.Seq and win.Wallpaper.Parent and not preload.IsLoaded and os.clock() < timeout do
                            task.wait(0.05)
                        end
                    end
                    if seq ~= media.Seq or not win.Wallpaper.Parent then
                        break
                    end
                    if frame[1] ~= first then
                        first = frame[1]
                        win.Wallpaper.Image = first
                    end
                    win.Wallpaper.ImageRectOffset = Vector2.new(frame[2], frame[3])
                end
            end)
        end
    end

    function media.Apply(name, window)
        media.Seq = media.Seq + 1
        local win = window or ZenthraUI.Windows[1]
        if type(name) == "table" then
            name = name[1]
        end
        if type(name) ~= "string" or name == "" or name == "None" then
            media.Stop(win)
            return
        end
        if name:find("rbxassetid://") then
            media.ShowStatic(name, win)
            return
        end
        local manifestPath = getMediaFolder() .. "/" .. name .. ".json"
        if typeof(isfile) == "function" and isfile(manifestPath) then
            local ok, result = pcall(function()
                return Http:JSONDecode(readfile(manifestPath))
            end)
            if ok and type(result) == "table" and result.count and type(result.pages) == "table" then
                local assets = {}
                for i, page in ipairs(result.pages) do
                    local asset = loadAsset(page)
                    if not asset or asset == "" then
                        media.Stop(win)
                        return
                    end
                    assets[i] = asset
                end
                media.PlayPages(assets, result, win)
                return
            end
        end
        local asset = loadAsset(name)
        if not asset or asset == "" then
            media.Stop(win)
            return
        end
        media.ShowStatic(asset, win)
    end

    function media.Delete(name)
        if type(name) ~= "string" or name == "" or name == "None" then
            return false, "Invalid name"
        end
        if typeof(delfile) ~= "function" then
            return false, "Executor does not support delfile"
        end
        if not (name:find("rbxassetid://") or name:find("http")) then
            local path = getMediaFolder() .. "/" .. name
            local ok, result = pcall(function()
                if typeof(isfile) == "function" and not isfile(path) then
                    error("File not found")
                end
                delfile(path)
                pcall(delfile, path .. ".json")
                local base = path:gsub("%.png$", ""):gsub("%.jpe?g$", ""):gsub("%.webm$", ""):gsub("%.mp4$", ""):gsub("%.gif$", "")
                if base ~= path then
                    for _, ext in ipairs({ "png", "jpg", "jpeg" }) do
                        local i = 2
                        while typeof(isfile) == "function" and isfile(base .. ".p" .. i .. "." .. ext) do
                            pcall(delfile, base .. ".p" .. i .. "." .. ext)
                            i = i + 1
                        end
                    end
                end
            end)
            if not ok then
                return false, tostring(result)
            end
            return true, name
        end
        return false, "Cannot delete remote/asset backgrounds"
    end

    return media
end

