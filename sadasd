                end,
            })

            bgMod:Input({ Title = "Media URL", Flag = "gui_bg_url", Placeholder = "https://... or rbxassetid://" })
            bgMod:Input({ Title = "Save as", Flag = "gui_bg_save_name", Placeholder = "Name for the file" })

            bgMod:Button({
                Title = "Download and use",
                Callback = function()
                    local url = ZenthraUI.Flags.gui_bg_url
                    if type(url) ~= "string" or url == "" then
                        ZenthraUI:Notify({ Title = "Background", Content = "Paste a URL first", Type = "error", Duration = 3 })
                        return
                    end
                    local cleanUrl = url:gsub("^%s+", ""):gsub("%s+$", "")
                    if cleanUrl:match("^%d+$") then
                        cleanUrl = "rbxassetid://" .. cleanUrl
                    end
                    if cleanUrl:find("rbxassetid://", 1, true) then
                        ZenthraUI.Flags.gui_background_image = cleanUrl
                        pcall(Internal.Config.Save)
                        applyBg(cleanUrl)
                        if bgDropdown and bgDropdown.Set then
                            pcall(bgDropdown.Set, bgDropdown, cleanUrl)
                        end
                        ZenthraUI:Notify({ Title = "Background", Content = "Applied", Type = "success", Duration = 2 })
                        return
                    end
                    ZenthraUI:Notify({ Title = "Background", Content = "Fetching...", Type = "info", Duration = 4 })
                    task.spawn(function()
                        local ok, result = mediaSys.Save(cleanUrl, ZenthraUI.Flags.gui_bg_save_name)
                        if not ok then
                            ZenthraUI:Notify({ Title = "Background", Content = tostring(result), Type = "error", Duration = 5 })
                            return
                        end
                        ZenthraUI.Flags.gui_background_image = result
                        pcall(Internal.Config.Save)
                        applyBg(result)
                        if bgDropdown and bgDropdown.SetOptions then
                            bgDropdown:SetOptions(mediaSys.List())
                            pcall(bgDropdown.Set, bgDropdown, result)
                        end
                        ZenthraUI:Notify({ Title = "Background", Content = "Applied: " .. tostring(result), Type = "success", Duration = 3 })
                    end)
                end,
            })

            bgMod:Button({
                Title = "Refresh List",
                Callback = function()
                    if bgDropdown and bgDropdown.SetOptions then
                        bgDropdown:SetOptions(mediaSys.List())
                    end
                end,
            })

            local deleteConfirm = false
            bgMod:Button({
                Title = "Delete Background",
                Callback = function()
                    local name = ZenthraUI.Flags.gui_background_image
                    if type(name) == "table" then
                        name = name[1]
                    end
                    if not name or name == "None" or name == "" then
                        deleteConfirm = false
                        ZenthraUI:Notify({
                            Title = "Background",
                            Content = "Select an image first",
                            Type = "error",
                            Duration = 3,
                        })
                        return
                    end
                    if not deleteConfirm then
                        deleteConfirm = true
                        ZenthraUI:Notify({
                            Title = "Background",
                            Content = "Are you sure? Click again to delete '" .. tostring(name) .. "'",
                            Type = "warning",
                            Duration = 5,
                        })
                        task.delay(5, function()
                            deleteConfirm = false
                        end)
                        return
                    end
                    deleteConfirm = false
                    local ok, result = mediaSys.Delete(name)
                    if ok then
                        ZenthraUI.Flags.gui_background_image = "None"
                        pcall(Internal.Config.Save)
                        mediaSys.Stop(window)
                        if bgDropdown and bgDropdown.SetOptions then
                            bgDropdown:SetOptions(mediaSys.List())
                        end
                        if bgDropdown and bgDropdown.Set then
                            pcall(bgDropdown.Set, bgDropdown, "None")
                        end
                        ZenthraUI:Notify({
                            Title = "Background",
                            Content = "Deleted " .. tostring(result),
                            Type = "info",
                            Duration = 3,
                        })
                    else
                        ZenthraUI:Notify({ Title = "Background", Content = tostring(result), Type = "error", Duration = 4 })
                    end
                end,
            })

            task.defer(function()
                mediaSys.SetOpacity(tonumber(ZenthraUI.Flags.gui_bg_image_opacity) or 0.45, window)
                applyBg()
            end)
        end
    end)

    local startMinimized = Internal.State.Saved.zenthra_start_minimized == true

    task.defer(function()
        if startMinimized then
            window.Open = false
            holder.Visible = false
            shadow.Visible = false
        else
            window:SetVisible(true)
        end
    end)

    local isDragging = false
    local dragStart = nil
    local startPos = nil
    local moved = false

    Internal.Util.Connect(topbar.InputBegan, function(input)
        if Internal.Window.BlockDrag then
            return
        end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        isDragging = true
        moved = false
        dragStart = input.Position
        startPos = holder.Position
    end)

    Internal.Util.Connect(UserInput.InputChanged, function(input)
        if not isDragging then
            return
        end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        local delta = input.Position - dragStart
        if 3 < delta.Magnitude then
            moved = true
        end
        holder.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X / uiScale.Scale, startPos.Y.Scale, startPos.Y.Offset + delta.Y / uiScale.Scale)
    end)

    Internal.Util.Connect(UserInput.InputEnded, function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        local wasClick = isDragging and not moved
        isDragging = false
        if wasClick and window.CompactPillActive and window.CompactPillActive() then
            window:Toggle()
        end
    end)

    table.insert(ZenthraUI.Windows, window)
    return window
end

local function wrapApi(fn)
    return function(self, ...)
        if self == ZenthraUI then
            return fn(...)
        end
        return fn(self, ...)
    end
end

ZenthraUI.Window = wrapApi(Internal.Window.Open)
ZenthraUI.Notify = wrapApi(Internal.Notify.Push)
ZenthraUI.SetTheme = wrapApi(Internal.Theme.Set)
ZenthraUI.SetAccent = wrapApi(Internal.Theme.SetAccent)
ZenthraUI.ResetTheme = wrapApi(Internal.Theme.Reset)
ZenthraUI.SetNotifyPosition = wrapApi(Internal.Notify.SetPosition)
ZenthraUI.GetNotifyPosition = wrapApi(Internal.Notify.GetPosition)
ZenthraUI.OnBindsChanged = wrapApi(Internal.Binds.OnChanged)
ZenthraUI.SaveConfig = wrapApi(Internal.Config.Save)
ZenthraUI.GetFlag = wrapApi(function(flag)
    return ZenthraUI.Flags[flag]
end)

local existing = getgenv and getgenv()._ZenthraUI
if type(existing) == "table" and type(existing.Unload) == "function" then
    pcall(existing.Unload)
end

getgenv()._ZenthraUI = {
    Unload = function()
        for _, conn in ipairs(Internal.State.Connections) do
            pcall(function()
                conn:Disconnect()
            end)
        end
        table.clear(Internal.State.Connections)
        for _, window in ipairs(ZenthraUI.Windows) do
            pcall(function()
                window:Destroy()
            end)
        end
    end
}

return ZenthraUI
