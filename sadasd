    local value = math.clamp(Internal.Util.Round(default, decimals), min, max)
    local root = Internal.Components.OptionRoot(parent, Env.Mobile and 38 or 32, order)

    local label = Internal.Util.Label({
        Text = config.Title or "Slider",
        TextSize = 12,
        ColorKey = "SubText",
        Size = UDim2.new(1, -60, 0, 14),
        Parent = root,
    })

    local valueLabel = Internal.Util.Label({
