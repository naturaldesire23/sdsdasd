                Parent = toggleSwitch,
            }, { Internal.Util.Corner(UDim.new(1, 0)) })
            Internal.Theme.Bind(toggleKnob, "BackgroundColor3", "Muted")

            Internal.Util.Connect(Internal.Util.New("TextButton", {
