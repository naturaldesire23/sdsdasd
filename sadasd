Internal.Binds.AttachKeybind = function(config)
    if Env.Mobile or not config.Flag then
        return nil
    end
    local flagKey = config.Flag .. "__key"
    local keyCode = Internal.Util.ToKeyCode(Internal.State.Saved[flagKey])
    local chip = Internal.Util.New("TextButton", {
        Name = "Keybind",
        Text = "",
        AutoButtonColor = false,
        AnchorPoint = config.AnchorPoint or Vector2.new(0, 0.5),
        Position = config.Position or UDim2.new(),
        LayoutOrder = config.LayoutOrder or 0,
        Size = UDim2.fromOffset(0, Internal.Layout.ChipH),
        AutomaticSize = Enum.AutomaticSize.X,
        BackgroundTransparency = 0.4,
        BorderSizePixel = 0,
        Parent = config.Parent,
    }, {
        Internal.Util.Corner(5),
        Internal.Util.Padding(0, 0, 6, 6),
        Internal.Util.New("UISizeConstraint", { MaxSize = Vector2.new(config.MaxWidth or 50, Internal.Layout.ChipH) }),
    })
    Internal.Theme.Bind(chip, "BackgroundColor3", "SurfaceAlt")
    local stroke = Internal.Util.Stroke("Border", 1, 0.25)
    stroke.Parent = chip

    local label = Internal.Util.Label({
        Text = "-",
        TextSize = 10,
        Weight = Internal.Layout.Weight.SemiBold,
        ColorKey = "SubText",
        TextXAlignment = Enum.TextXAlignment.Center,
        AutomaticSize = Enum.AutomaticSize.X,
        Size = UDim2.fromOffset(0, Internal.Layout.ChipH),
        Parent = chip,
    })

    local bindEntry = { Flag = config.Flag, Label = config.Label or "Bind", Key = keyCode }
    table.insert(ZenthraUI.Binds, bindEntry)
    local listening = false

    local function update()
        label.Text = listening and "?" or (keyCode and Internal.Util.KeyName(keyCode) or "-")
        label.TextColor3 = (listening or keyCode) and palette.Text or palette.Muted
        Internal.Util.Tween(stroke, { Color = listening and palette.Accent or palette.Border, Transparency = listening and 0.3 or 0.25 }, 0.18)
        bindEntry.Key = keyCode
        Internal.Binds.Changed()
    end
    update()

    local function startListening()
        if Internal.Binds.Binding then
            return
        end
        Internal.Binds.Binding = true
        listening = true
        update()
        local conn
        conn = Internal.Util.Connect(UserInput.InputBegan, function(input)
            if input.UserInputType ~= Enum.UserInputType.Keyboard then
                return
            end
            if input.KeyCode == Enum.KeyCode.Unknown then
                return
            end
            conn:Disconnect()
            listening = false
            keyCode = not (input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.Escape) and input.KeyCode or nil
            Internal.Config.SetFlag(flagKey, keyCode)
            update()
            task.defer(function()
                Internal.Binds.Binding = false
            end)
        end)
    end

    Internal.Util.Connect(chip.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 then
            startListening()
        end
    end)

    if config.Host then
        Internal.Util.Connect(config.Host.InputBegan, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton2 then
                startListening()
            end
        end)
    end

    Internal.Util.Connect(UserInput.InputBegan, function(input, gameProcessed)
        if gameProcessed or Internal.Binds.Binding or not keyCode then
            return
        end
        if input.KeyCode == keyCode and config.OnPress then
            task.spawn(config.OnPress)
        end
    end)

    Internal.Util.Hover(chip, function()
        Internal.Util.Tween(chip, { BackgroundTransparency = 0.1 }, 0.16)
    end, function()
        Internal.Util.Tween(chip, { BackgroundTransparency = 0.4 }, 0.2)
    end)

    return {
        Chip = chip,
        Get = function()
            return keyCode
        end,
    }
end

