            end
            local h = getBodyHeight()
            if animated == false then
                body.Size = UDim2.new(1, 0, 0, h)
            else
                Internal.Util.Tween(body, { Size = UDim2.new(1, 0, 0, h) }, 0.3)
            end
        end

        Internal.Util.Connect(uiListLayout:GetPropertyChangedSignal("AbsoluteContentSize"), function()
            obj:Resize(true)
        end)

        obj.SetExpanded = function(_, expanded, animated)
            if #content:GetChildren() <= 2 then
                expanded = false
            end
            obj.Expanded = expanded
            local targetH = expanded and getBodyHeight() or 0
            if animated == false then
                body.Size = UDim2.new(1, 0, 0, targetH)
            else
                Internal.Util.Tween(body, { Size = UDim2.new(1, 0, 0, targetH) }, 0.34)
            end
        end

        obj.SetEnabled = function(_, state, silent, instant)
            local enabled = state == true
            obj.Enabled = enabled
            Internal.Config.SetFlag(obj.Flag, enabled)

            if toggleSwitch then
                Internal.Util.Tween(toggleSwitch, {
                    BackgroundColor3 = enabled and palette.Accent or palette.SurfaceAlt,
                    BackgroundTransparency = enabled and 0.05 or 0.45,
                }, 0.26)

                Internal.Util.Tween(toggleKnob, {
                    Position = enabled and UDim2.new(1, -15, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
                    BackgroundColor3 = enabled and palette.Background or palette.Muted,
                }, 0.32)
            end

            Internal.Util.Tween(obj.Stroke, { Color = enabled and palette.Accent or palette.Border, Transparency = enabled and 0.3 or 0.3 }, 0.3)
            Internal.Util.Tween(titleLabel, { TextColor3 = (enabled or not obj.Toggleable) and palette.Text or palette.SubText }, 0.26)

            if obj.Toggleable then
                obj:SetExpanded(true, not instant)
            end

            if not silent then
                if config.Callback then
                    task.spawn(config.Callback, enabled)
                end
            end
        end

        obj.Get = function()
            return obj.Enabled
        end

        if hasKeybind then
            Internal.Binds.AttachKeybind({
                Parent = header,
                Host = header,
                AnchorPoint = Vector2.new(0, 0.5),
                Position = UDim2.new(0, 12, 0, keybindOffset),
                Flag = obj.Flag,
                Label = obj.Title,
                MaxWidth = 84,
                OnPress = function()
                    obj:SetEnabled(not obj.Enabled)
                end,
            })
        end

        Internal.Util.Connect(header.MouseButton1Click, function()
