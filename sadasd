    }, { Internal.Util.Corner(UDim.new(1, 0)), Internal.Util.Stroke("BorderSoft", 1, 0.25) })
    Internal.Theme.Bind(track, "BackgroundColor3", "SurfaceAlt")

    local fill = Internal.Util.New("Frame", {
        Size = UDim2.fromScale(0, 1),
        BorderSizePixel = 0,
        Parent = track,
    }, {
        Internal.Util.Corner(UDim.new(1, 0)),
        Internal.Util.Gradient(function()
            return ColorSequence.new({
                ColorSequenceKeypoint.new(0, palette.AccentDim),
                ColorSequenceKeypoint.new(0.5, palette.AccentSoft),
                ColorSequenceKeypoint.new(1, palette.Accent),
            })
        end),
    })
    Internal.Theme.Bind(fill, "BackgroundColor3", "Accent")

    local knob = Internal.Util.New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.fromOffset(12, 9),
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = fill,
    }, { Internal.Util.Corner(UDim.new(1, 0)) })
    Internal.Theme.Bind(knob, "BackgroundColor3", "AccentSoft")

    local hitbox = Internal.Util.New("TextButton", {
        Text = "",
        AutoButtonColor = false,
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 0, 1, 0),
        Size = UDim2.new(1, 0, 0, Env.Mobile and 22 or 16),
        Parent = root,
    })

    local entry = {
        Type = "Slider",
        Value = value,
        Root = root,
        Set = function(_, newVal, silent, instant)
            local v = math.clamp(Internal.Util.Round(tonumber(newVal) or min, decimals), min, max)
            entry.Value = v
            Internal.Config.SetFlag(config.Flag, v)
            local pct = max > min and (v - min) / (max - min) or 0
            valueLabel.Text = tostring(v) .. suffix
            if instant then
                fill.Size = UDim2.fromScale(pct, 1)
            else
                Internal.Util.Tween(fill, { Size = UDim2.fromScale(pct, 1) }, 0.16)
            end
            if not silent and config.Callback then
                task.spawn(config.Callback, v)
            end
        end,
        Get = function()
            return entry.Value
        end,
    }

    local dragging = false
    local function updateFromInput(pos)
        local trackSize = track.AbsoluteSize.X
        if trackSize < 1 then
            return
        end
        entry:Set(min + (max - min) * math.clamp((pos.X - track.AbsolutePosition.X) / trackSize, 0, 1), false, true)
    end

    Internal.Util.Connect(hitbox.InputBegan, function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        dragging = true
        Internal.Window.BlockDrag = true
        Internal.Util.Tween(knob, { Size = UDim2.fromOffset(14, 12) }, 0.09)
        updateFromInput(input.Position)
    end)

    Internal.Util.Connect(UserInput.InputChanged, function(input)
        if not dragging then
            return
        end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            updateFromInput(input.Position)
        end
    end)

    Internal.Util.Connect(UserInput.InputEnded, function(input)
        if not dragging then
            return
        end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        dragging = false
        Internal.Window.BlockDrag = false
        Internal.Util.Tween(knob, { Size = UDim2.fromOffset(12, 9) }, 0.2)
        Internal.Config.Queue()
    end)

    Internal.Util.Hover(hitbox, function()
        Internal.Util.Tween(label, { TextColor3 = palette.Text }, 0.16)
    end, function()
        if not dragging then
            Internal.Util.Tween(label, { TextColor3 = palette.SubText }, 0.2)
        end
    end)

    entry:Set(value, true, true)
    if config.Callback then
        task.spawn(config.Callback, value)
    end
    return entry
end

