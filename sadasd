Internal.Util.Round = function(value, decimals)
    local factor = 10 ^ (decimals or 0)
    return math.floor(value * factor + 0.5) / factor
end

Internal.Util.KeyName = function(keyCode)
    if typeof(keyCode) == "EnumItem" then
        return (tostring(keyCode):gsub("Enum.KeyCode.", ""):gsub("Enum.UserInputType.", ""))
    end
    return "None"
end

Internal.Util.ToKeyCode = function(value)
    if typeof(value) == "EnumItem" then
        return value
    end
    if type(value) ~= "string" then
        return nil
    end
    local ok, result = pcall(function()
        return Enum.KeyCode[value]
    end)
    return ok and result or nil
end

Internal.Theme.Bind = function(instance, property, key)
    table.insert(Internal.State.ThemeBindings, { instance = instance, property = property, key = key })
    instance[property] = palette[key]
    return instance
end

Internal.Theme.BindDynamic = function(instance, property, resolver)
    table.insert(Internal.State.ThemeBindings, { instance = instance, property = property, resolve = resolver })
    instance[property] = resolver()
    return instance
end

Internal.Theme.Set = function(overrides)
    overrides = overrides or {}
    for k, v in pairs(overrides) do
        if palette[k] ~= nil and typeof(v) == "Color3" then
            palette[k] = v
        end
    end
    for i = #Internal.State.ThemeBindings, 1, -1 do
        local binding = Internal.State.ThemeBindings[i]
        if not pcall(function()
            binding.instance[binding.property] = binding.resolve and binding.resolve() or palette[binding.key]
        end) then
            table.remove(Internal.State.ThemeBindings, i)
        end
    end
end

