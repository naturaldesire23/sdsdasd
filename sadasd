Internal.Window.BindGameCursor = function(gui)
    if typeof(gui) ~= "Instance" then
        return
    end
    local cursorFrame = Internal.Util.New("Frame", {
        Name = "GameCursor",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.fromScale(1, 1),
        Active = false,
        ZIndex = 100000,
        Parent = gui,
    })

    local realCursor = nil
    local clone = nil

    local function findCursor()
        if realCursor and realCursor.Parent then
            return realCursor
        end
        local playerGui = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
        local interface = playerGui and playerGui:FindFirstChild("Interface")
        realCursor = interface and interface:FindFirstChild("Cursor")
        if not realCursor and playerGui then
            realCursor = playerGui:FindFirstChild("Cursor", true)
        end
        if realCursor and (not clone or not clone.Parent) then
            if clone then
                pcall(function() clone:Destroy() end)
            end
            clone = realCursor:Clone()
            clone.Name = "Cursor"
            clone.ZIndex = 100001
            clone.Active = false
            clone.Parent = cursorFrame
        end
        return realCursor
    end

    local function syncProperties(src, dst, useAbs)
        if typeof(src) ~= "Instance" or typeof(dst) ~= "Instance" then
            return
        end
        if src:IsA("GuiObject") and dst:IsA("GuiObject") then
            dst.Visible = src.Visible
            dst.AnchorPoint = src.AnchorPoint
            dst.Rotation = src.Rotation
            if useAbs then
                local absPos = src.AbsolutePosition
                local absSize = src.AbsoluteSize
                local ap = src.AnchorPoint
                local parent = dst.Parent
                local parentAbs = parent and parent:IsA("GuiObject") and parent.AbsolutePosition or Vector2.zero
                dst.Size = UDim2.fromOffset(absSize.X, absSize.Y)
                dst.Position = UDim2.fromOffset(absPos.X + absSize.X * ap.X - parentAbs.X, absPos.Y + absSize.Y * ap.Y - parentAbs.Y)
            else
                dst.Size = src.Size
                dst.Position = src.Position
            end
        end
        if src:IsA("ImageLabel") and dst:IsA("ImageLabel") then
            dst.Image = src.Image
            dst.ImageColor3 = src.ImageColor3
            dst.ImageTransparency = src.ImageTransparency
            dst.ImageRectOffset = src.ImageRectOffset
            dst.ImageRectSize = src.ImageRectSize
            dst.ScaleType = src.ScaleType
        end
        if src:IsA("TextLabel") and dst:IsA("TextLabel") then
            dst.Text = src.Text
            dst.TextColor3 = src.TextColor3
            dst.TextTransparency = src.TextTransparency
            dst.TextStrokeTransparency = src.TextStrokeTransparency
            dst.TextSize = src.TextSize
        end
        for _, child in ipairs(src:GetChildren()) do
            local match = dst:FindFirstChild(child.Name)
            if match then
                syncProperties(child, match, false)
            end
        end
    end

    Internal.Util.Connect(Run.RenderStepped, function()
        local cursor = findCursor()
        if cursor and clone then
            syncProperties(cursor, clone, true)
        elseif clone then
            clone.Visible = false
        end
    end)
end

