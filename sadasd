    if Internal.State.Saved[config.Flag] ~= nil then
        default = Internal.State.Saved[config.Flag]
    end
    local keyCode = Internal.Util.ToKeyCode(default)
    local root = Internal.Components.OptionRoot(parent, Internal.Layout.Row, order)

    Internal.Util.Label({
        Text = config.Title or "Keybind",
        TextSize = 12,
        ColorKey = "SubText",
        Size = UDim2.new(1, -70, 1, 0),
        Parent = root,
    })

    local button = Internal.Util.New("TextButton", {
        Text = "",
        AutoButtonColor = false,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.fromOffset(60, 20),
        BackgroundTransparency = 0.4,
        BorderSizePixel = 0,
        Parent = root,
    }, { Internal.Util.Corner(6), Internal.Util.Stroke("Border", 1, 0.25) })
    Internal.Theme.Bind(button, "BackgroundColor3", "SurfaceAlt")

    local label = Internal.Util.Label({
        Text = Internal.Util.KeyName(keyCode),
        TextSize = 11,
        ColorKey = keyCode and "Text" or "Muted",
        TextXAlignment = Enum.TextXAlignment.Center,
        Size = UDim2.fromScale(1, 1),
        Parent = button,
    })

    local listening = false
    local entry = { Type = "Keybind", Value = keyCode, Root = root }
    local bindEntry = { Flag = config.Flag, Label = config.Title or "Keybind", Key = keyCode }
    table.insert(ZenthraUI.Binds, bindEntry)

    entry.Set = function(_, newVal, silent)
        entry.Value = newVal
        label.Text = Internal.Util.KeyName(newVal)
        label.TextColor3 = newVal and palette.Text or palette.Muted
        Internal.Config.SetFlag(config.Flag, newVal)
        bindEntry.Key = newVal
        Internal.Binds.Changed()
        if not silent and config.Changed then
            task.spawn(config.Changed, newVal)
        end
    end

    entry.Get = function()
        return entry.Value
    end

    Internal.Util.Connect(button.MouseButton1Click, function()
        if listening then
            return
        end
        listening = true
        Internal.Binds.Binding = true
        label.Text = "..."
        label.TextColor3 = palette.Accent
    end)

    Internal.Util.Connect(UserInput.InputBegan, function(input, gameProcessed)
        if listening then
            if input.UserInputType == Enum.UserInputType.Keyboard then
                listening = false
                Internal.Binds.Binding = false
                if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
                    entry:Set(nil)
                else
                    entry:Set(input.KeyCode)
                end
            end
            return
        end
        if gameProcessed or not entry.Value then
            return
        end
        if input.KeyCode == entry.Value and config.Callback then
            task.spawn(config.Callback)
        end
    end)

    Internal.Util.Hover(button, function()
        if not listening then
            Internal.Util.Tween(button, { BackgroundTransparency = 0.15 }, 0.16)
        end
    end, function()
        Internal.Util.Tween(button, { BackgroundTransparency = 0.4 }, 0.2)
    end)

    entry:Set(keyCode, true)
    return entry
end

