    local function updateMouseBehavior()
        if window.Open == true and holder.Visible and not minimized then
            if mouseConn then
                return
            end
            mouseConn = Run.RenderStepped:Connect(function()
                local rmb = UserInput:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
                local alt = UserInput:IsKeyDown(Enum.KeyCode.LeftAlt) or UserInput:IsKeyDown(Enum.KeyCode.RightAlt)
                if isInFirstPerson() then
                    UserInput.MouseBehavior = alt and Enum.MouseBehavior.Default or Enum.MouseBehavior.LockCenter
                    return
                end
                if rmb then
                    UserInput.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
                    return
                end
                UserInput.MouseBehavior = Enum.MouseBehavior.Default
            end)
        elseif mouseConn then
            mouseConn:Disconnect()
            mouseConn = nil
        end
