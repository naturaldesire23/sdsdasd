Env.Adopt = function(gui)
    local protect = rawget(getgenv(), "protectgui")
    if typeof(protect) ~= "function" then
        local syn = rawget(getgenv(), "syn")
        protect = type(syn) == "table" and syn.protect_gui or nil
    end
    if typeof(protect) == "function" then
        pcall(protect, gui)
    end
    table.insert(Env.Registry(), gui)
    return gui
end

Env.SafeParent = function()
    local playerGui = LocalPlayer and (LocalPlayer:FindFirstChild("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 8))
    if typeof(gethui) == "function" then
        local ok, result = pcall(gethui)
        if ok and typeof(result) == "Instance" then
            local isPlayerGui = result == playerGui
            if not isPlayerGui and playerGui then
                local ok2, isDescendant = pcall(function()
                    return result:IsDescendantOf(playerGui)
                end)
                isPlayerGui = ok2 and isDescendant
            end
            if not isPlayerGui then
                if pcall(function() result:GetChildren() end) then
                    return result
                end
            end
        end
    end
    if pcall(function() return CoreGui.Name end) then
        return CoreGui
    end
    return playerGui or CoreGui
end

Env.PlayerGuiParent = function()
    if not LocalPlayer then
        return nil
    end
    return LocalPlayer:FindFirstChild("PlayerGui")
end

Env.GuiParent = function()
    local ok, result = pcall(function()
        return CoreGui
    end)
    if ok and typeof(result) == "Instance" then
        return result
    end
    return Env.PlayerGuiParent()
end

Env.GuiDisplayOrder = 2147483646
Env.NotifyDisplayOrder = 2147483647

Env.PromoteGui = function(gui, displayOrder)
    if typeof(gui) ~= "Instance" then
        return
    end
    local ok, isScreenGui = pcall(function()
        return gui:IsA("ScreenGui")
    end)
    if not ok or not isScreenGui then
        return
    end
    displayOrder = displayOrder or Env.GuiDisplayOrder
    pcall(function()
        gui.IgnoreGuiInset = true
        gui.ResetOnSpawn = false
        gui.AutoLocalize = false
        gui.DisplayOrder = displayOrder
        gui.Enabled = true
    end)
    pcall(function()
        gui.ClipToDeviceSafeArea = false
    end)
    pcall(function()
        gui.SafeAreaCompatibility = Enum.SafeAreaCompatibility.None
    end)
    pcall(function()
        gui.ScreenInsets = Enum.ScreenInsets.None
    end)
    pcall(function()
        gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    end)
    local parent = Env.GuiParent()
    local fallback = Env.PlayerGuiParent()
    if parent and gui.Parent ~= parent then
        if not pcall(function() gui.Parent = parent end) or gui.Parent ~= parent then
            if fallback and gui.Parent ~= fallback then
                pcall(function() gui.Parent = fallback end)
            end
        end
    end
end

