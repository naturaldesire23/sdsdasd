        Text = "",
        AutoButtonColor = false,
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Parent = root,
    }, { Internal.Util.FlexRow(7) })

    local label = Internal.Util.Label({
        Text = config.Title or "Toggle",
        TextSize = 12,
        ColorKey = "SubText",
        TextTruncate = Enum.TextTruncate.AtEnd,
        Size = UDim2.new(0, 0, 1, 0),
        LayoutOrder = 1,
        Parent = button,
    }, { Internal.Util.Grow() })

    local entry = { Type = "Toggle", Value = value, Root = root }

    local bell
    if config.Notify and config.Flag then
        bell = Internal.Binds.AttachBell({ Parent = button, LayoutOrder = 3, Flag = config.Flag })
    end

    local toggleFrame = Internal.Util.New("Frame", {
        Size = UDim2.fromOffset(30, 16),
        BackgroundTransparency = 0.5,
        BorderSizePixel = 0,
        LayoutOrder = 4,
        Parent = button,
    }, { Internal.Util.Corner(UDim.new(1, 0)), Internal.Util.Stroke("Border", 1, 0.2) })
    Internal.Theme.Bind(toggleFrame, "BackgroundColor3", "SurfaceAlt")

    local knob = Internal.Util.New("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 3, 0.5, 0),
        Size = UDim2.fromOffset(10, 10),
        BorderSizePixel = 0,
        Parent = toggleFrame,
    }, { Internal.Util.Corner(UDim.new(1, 0)) })
    Internal.Theme.Bind(knob, "BackgroundColor3", "Muted")

    entry.Set = function(_, newValue, silent)
        local v = newValue == true
        entry.Value = v
        Internal.Config.SetFlag(config.Flag, v)

        Internal.Util.Tween(toggleFrame, {
            BackgroundColor3 = v and palette.Accent or palette.SurfaceAlt,
            BackgroundTransparency = v and 0.05 or 0.5,
        }, 0.2)

        Internal.Util.Tween(knob, {
            Position = v and UDim2.new(1, -13, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
            BackgroundColor3 = v and palette.Background or palette.Muted,
        }, 0.3)

        Internal.Util.Tween(label, { TextColor3 = v and palette.Text or palette.SubText }, 0.24)

        if not silent then
            if config.Callback then
                task.spawn(config.Callback, v)
            end
            if bell then
                bell.Announce(config.Title or "Toggle", v)
            end
        end
    end

    entry.Get = function()
        return entry.Value
    end

    Internal.Util.Connect(button.MouseButton1Click, function()
        entry:Set(not entry.Value)
    end)

    Internal.Util.Hover(button, function()
        if not entry.Value then
            Internal.Util.Tween(label, { TextColor3 = palette.Text }, 0.16)
        end
    end, function()
        if not entry.Value then
            Internal.Util.Tween(label, { TextColor3 = palette.SubText }, 0.2)
        end
    end)

    if config.Keybind ~= false and config.Flag then
        Internal.Binds.AttachKeybind({
            Parent = button,
            Host = button,
            LayoutOrder = 2,
            Flag = config.Flag,
            Label = config.Title or "Toggle",
            MaxWidth = 54,
            OnPress = function()
                entry:Set(not entry.Value)
            end,
        })
    end

    entry:Set(value, true)
    if value and config.Callback then
        task.spawn(config.Callback, value)
    end

    return entry
end

Internal.Components.Slider = function(parent, config, order)
