Internal.Util.HookMethod = function(target, key, hookFn)
    if type(target) ~= "table" or type(hookFn) ~= "function" then
        return nil
    end
    local registry = Internal.Util.HookRegistry()
    local existing = nil
    for _, h in ipairs(registry) do
        if h.target == target and h.key == key then
            existing = h
            break
        end
    end
    if existing then
        if existing.undo then
            pcall(existing.undo)
            existing.undo = nil
        end
        if type(existing.original) == "function" then
            target[key] = existing.original
        end
    end
    local original = target[key]
    if type(original) ~= "function" then
        return nil
    end
    local wrapped = function(...)
        return original(...)
    end
    local hooked = hookFn(wrapped)
    if type(hooked) ~= "function" then
        return nil
    end
    local replacement = function(...)
        return hooked(...)
    end

    local entry = existing or { target = target, key = key }
    entry.original = original
    entry.undo = nil

    if typeof(hookfunction) == "function" then
        local ok, result = pcall(hookfunction, original, replacement)
        if ok and type(result) == "function" then
            wrapped = result
            entry.undo = function()
                pcall(hookfunction, original, result)
            end
            if not existing then
                registry[#registry + 1] = entry
            end
            return wrapped
        end
    end

    target[key] = replacement
    entry.undo = function()
        target[key] = original
    end
    if not existing then
        registry[#registry + 1] = entry
    end
    return wrapped
end

Internal.Notify.Profile = function()
    return Internal.Notify.Profiles[Internal.Notify.Position] or Internal.Notify.Profiles["Right Bottom"]
end

Internal.Notify.BaseOffset = function(profile)
    if profile.sign > 0 then
        return Internal.Notify.Edge + Internal.Services.Gui:GetGuiInset().Y
    end
    return Internal.Notify.Edge
end

Internal.Notify.Restack = function(animated)
    local profile = Internal.Notify.Profile()
    local offset = Internal.Notify.BaseOffset(profile)
    for _, card in ipairs(Internal.Notify.Active) do
        if not card.Dismissing and card.Card.Parent then
            card.Card.AnchorPoint = Vector2.new(profile.ax, profile.ay)
            local pos = UDim2.new(profile.xs, profile.shown, profile.ys, profile.sign * offset)
            if animated == false then
                card.Card.Position = pos
            else
                Internal.Util.Tween(card.Card, { Position = pos }, 0.34)
            end
            offset = offset + card.Height + Internal.Notify.Gap
        end
    end
end

Internal.Notify.SetPosition = function(position)
    if not Internal.Notify.Profiles[position] then
        return false
    end
    Internal.Notify.Position = position
    Internal.Notify.Restack(true)
    return true
end

Internal.Notify.GetPosition = function()
    return Internal.Notify.Position
end

Internal.Notify.Push = function(arg, arg2)
    local data
    if type(arg) == "string" then
        data = { Title = arg, Text = arg2 }
    else
        data = arg
    end
    data = data or {}
    local kind = Internal.Notify.Kinds[tostring(data.Type or "info"):lower()] or Internal.Notify.Kinds.info
    local duration = data.Duration or 4
    local profile = Internal.Notify.Profile()
    local title = data.Title or data.Header or "Zenthra"
    local text = data.Text or data.Content or data.Description or data.Message

    if text ~= nil then
        text = tostring(text)
        if text == "" then
            text = nil
        end
    end

    local cardProps = {
        Name = "Notification",
        AnchorPoint = Vector2.new(profile.ax, profile.ay),
        Size = UDim2.fromOffset(Internal.Notify.Width, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        GroupTransparency = 1,
        BackgroundTransparency = 0.02,
        BorderSizePixel = 0,
    }
    local cardChildren = {
        Internal.Util.Corner(10),
        Internal.Util.Stroke("Border", 1, 0.2),
        Internal.Util.Padding(12, 12, 12, 12),
    }
    local card = Internal.Util.New("CanvasGroup", cardProps, cardChildren)
    Internal.Theme.Bind(card, "BackgroundColor3", "Surface")
    card.Parent = Internal.Env.NotifyGui and Internal.Env.NotifyGui:FindFirstChild("Container") or Internal.Env.PlayerGuiParent()

    local iconFrame = Internal.Util.New("Frame", {
        Size = UDim2.fromOffset(26, 26),
        BackgroundTransparency = 0.86,
        BorderSizePixel = 0,
        Parent = card,
    }, { Internal.Util.Corner(8) })
    Internal.Theme.Bind(iconFrame, "BackgroundColor3", kind.key)

    Internal.Util.Image({
        Image = data.Icon or kind.glyph,
        Size = UDim2.fromOffset(14, 14),
        Position = UDim2.fromScale(0.5, 0.5),
        AnchorPoint = Vector2.new(0.5, 0.5),
        ColorKey = kind.key,
        Parent = iconFrame,
    })

    local textFrame = Internal.Util.New("Frame", {
        Position = UDim2.fromOffset(36, 0),
        Size = UDim2.new(1, -36, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Parent = card,
    }, { Internal.Util.List(3) })

    Internal.Util.Label({
        Text = tostring(title),
        TextSize = 13,
        Weight = Internal.Layout.Weight.Bold,
        Size = UDim2.new(1, 0, 0, 15),
        Parent = textFrame,
    })

    if text then
        Internal.Util.Label({
            Text = text,
            TextSize = 12,
            ColorKey = "SubText",
            TextWrapped = true,
            RichText = data.RichText == true,
            AutomaticSize = Enum.AutomaticSize.Y,
            Size = UDim2.new(1, 0, 0, 0),
            Parent = textFrame,
        })
    end

    local barFrame = Internal.Util.New("Frame", {
        Size = UDim2.new(1, 0, 0, 11),
        BackgroundTransparency = 1,
        LayoutOrder = 9,
        Parent = textFrame,
    })

    local barBg = Internal.Util.New("Frame", {
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 0, 1, 0),
        Size = UDim2.new(1, 0, 0, 3),
        BackgroundTransparency = 0.86,
        BorderSizePixel = 0,
        Parent = barFrame,
    }, { Internal.Util.Corner(2) })
    Internal.Theme.Bind(barBg, "BackgroundColor3", "SurfaceAlt")

    local barFill = Internal.Util.New("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BorderSizePixel = 0,
        Parent = barBg,
    }, { Internal.Util.Corner(2) })
    Internal.Theme.Bind(barFill, "BackgroundColor3", kind.key)

    local entry = { Card = card, Height = 64, Dismissing = false }
    table.insert(Internal.Notify.Active, 1, entry)

    local function updateHeight()
        local scale = 1
        local uiScale = card:FindFirstChildOfClass("UIScale")
        if uiScale then
            scale = uiScale.Scale
        end
        return card.AbsoluteSize.Y / math.max(scale, 0.01)
    end

    entry.Resize = card:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        local h = updateHeight()
        local changed = h > 0
        if changed then
            changed = math.abs(h - entry.Height) > 0.5
        end
        if changed then
            entry.Height = h
            if not entry.Dismissing then
                Internal.Notify.Restack(true)
            end
        end
    end)

    card.Position = UDim2.new(profile.xs, profile.hidden, profile.ys, profile.sign * Internal.Notify.BaseOffset(profile))

    task.defer(function()
        if not card.Parent then
            return
        end
        entry.Height = math.max(updateHeight(), 1)
        Internal.Notify.Restack(true)
        Internal.Util.Tween(card, { GroupTransparency = 0 }, 0.3)
        Internal.Util.Tween(barFill, { Size = UDim2.new(0, 0, 1, 0) }, duration, Enum.EasingStyle.Linear)
    end)

    local function dismiss()
        if entry.Dismissing or not card.Parent then
            return
        end
        entry.Dismissing = true

        if entry.Resize then
            entry.Resize:Disconnect()
            entry.Resize = nil
        end

        for i, v in ipairs(Internal.Notify.Active) do
            if v == entry then
                table.remove(Internal.Notify.Active, i)
                break
            end
        end

        Internal.Notify.Restack(true)
        local prof = Internal.Notify.Profile()
        Internal.Util.Tween(card, { Position = UDim2.new(prof.xs, prof.hidden, card.Position.Y.Scale, card.Position.Y.Offset) }, 0.28, Internal.Layout.Ease, Internal.Layout.EaseIn)
        Internal.Util.Tween(card, { GroupTransparency = 1 }, 0.24, Enum.EasingStyle.Quad, Internal.Layout.EaseIn)

        task.delay(0.3, function()
            card:Destroy()
        end)
    end

    entry.Dismiss = dismiss
    task.delay(duration, dismiss)
    return entry
end

