        Text = "None",
        TextSize = 12,
        ColorKey = "Text",
        TextTruncate = Enum.TextTruncate.AtEnd,
        Size = UDim2.new(1, -20, 1, 0),
        Parent = button,
    })

    local chevron = Internal.Util.Image({
        Image = "chevronDown",
        Size = UDim2.fromOffset(12, 12),
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        ColorKey = "Muted",
        Parent = button,
    })

    local listContainer = Internal.Util.New("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        Parent = root,
    })

    local scroller = Internal.Util.New("ScrollingFrame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 0.35,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageTransparency = 0.4,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(),
        ScrollingDirection = Enum.ScrollingDirection.Y,
        Parent = listContainer,
    }, {
        Internal.Util.Corner(7),
        Internal.Util.Stroke("Border", 1, 0.25),
        Internal.Util.Padding(4, 4, 4, 4),
        Internal.Util.List(2),
    })
    Internal.Theme.Bind(scroller, "BackgroundColor3", "SurfaceAlt")
    Internal.Theme.Bind(scroller, "ScrollBarImageColor3", "Muted")

    local optionButtons = {}
    local expanded = false
    local entry = {
        Type = "Dropdown",
        Value = value,
        Options = options,
        Root = root,
    }

    local function isSelected(opt)
        if multi then
            return entry.Value[opt] == true
        end
        return entry.Value == opt
    end

    local function updateDisplay()
        if multi then
            local selected = {}
            for _, opt in ipairs(entry.Options) do
                if entry.Value[opt] then
                    table.insert(selected, opt)
                end
            end
            valueLabel.Text = #selected > 0 and table.concat(selected, ", ") or "None"
            valueLabel.TextColor3 = #selected > 0 and palette.Text or palette.Muted
        else
            valueLabel.Text = entry.Value and tostring(entry.Value) or "None"
            valueLabel.TextColor3 = entry.Value and palette.Text or palette.Muted
        end

        for opt, elements in pairs(optionButtons) do
            local selected = isSelected(opt)
            Internal.Util.Tween(elements.label, { TextColor3 = selected and palette.Text or palette.SubText }, 0.16)
            Internal.Util.Tween(elements.frame, { BackgroundTransparency = selected and 0.86 or 1 }, 0.16)
            if elements.tick then
                Internal.Util.Tween(elements.tick, { ImageTransparency = selected and 0 or 1 }, 0.16)
            end
        end
    end

    local function getHeight()
        local count = math.min(#entry.Options, maxVisible)
        if count == 0 then
            return 0
        end
        return count * Internal.Layout.OptionH + (count - 1) * 2 + 8
    end

    local function toggleList(state)
        expanded = state
        Internal.Util.Tween(listContainer, { Size = UDim2.new(1, 0, 0, expanded and getHeight() or 0) }, 0.28)
        Internal.Util.Tween(chevron, { Rotation = expanded and 180 or 0 }, 0.22)
        Internal.Util.Tween(uiStroke, { Color = expanded and palette.Accent or palette.Border, Transparency = expanded and 0.4 or 0.25 }, 0.22)
    end

    local function selectOption(opt)
        if multi then
            local newVals = table.clone(entry.Value)
            newVals[opt] = not newVals[opt] or nil
            entry:Set(newVals)
        else
            entry:Set(opt)
            toggleList(false)
        end
    end

    entry.Set = function(_, newVal, silent)
        if multi then
            local cleanVals = {}
            if type(newVal) == "table" then
                if #newVal > 0 then
                    for _, v in ipairs(newVal) do
                        cleanVals[v] = true
                    end
                else
                    for k, v in pairs(newVal) do
                        if v then
                            cleanVals[k] = true
                        end
                    end
                end
            end
            entry.Value = cleanVals
        else
            entry.Value = newVal
        end
        Internal.Config.SetFlag(config.Flag, entry.Value)
        updateDisplay()

        if not silent then
            if config.Callback then
                task.spawn(config.Callback, entry.Value)
            end
            if bell then
                bell.Announce(config.Title or "Dropdown", valueLabel.Text)
            end
        end
    end

    entry.Get = function()
        return entry.Value
    end

    entry.SetOptions = function(_, newOptions)
        entry.Options = newOptions or {}
        for _, elements in pairs(optionButtons) do
            elements.frame:Destroy()
        end
        optionButtons = {}

        for i, opt in ipairs(entry.Options) do
            local btn = Internal.Util.New("TextButton", {
                Text = "",
                AutoButtonColor = false,
                Size = UDim2.new(1, 0, 0, Internal.Layout.OptionH),
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                LayoutOrder = i,
                Parent = scroller,
            }, {
                Internal.Util.Corner(5),
                Internal.Util.Padding(0, 0, 8, 8),
                Internal.Util.FlexRow(6),
            })
            Internal.Theme.Bind(btn, "BackgroundColor3", "Accent")

            local lbl = Internal.Util.Label({
                Text = tostring(opt),
                TextSize = 11.5,
                ColorKey = "SubText",
                TextTruncate = Enum.TextTruncate.AtEnd,
                Size = UDim2.new(0, 0, 1, 0),
                LayoutOrder = 1,
                Parent = btn,
            }, { Internal.Util.Grow() })

            local tickImg = Internal.Util.Image({
                Image = "check",
                Size = UDim2.fromOffset(12, 12),
                ImageTransparency = 1,
                ColorKey = "Accent",
                LayoutOrder = 2,
                Parent = btn,
            })

            optionButtons[opt] = { frame = btn, label = lbl, tick = tickImg }

            Internal.Util.Connect(btn.MouseButton1Click, function()
                selectOption(opt)
            end)
            Internal.Util.Hover(btn, function()
                if not isSelected(opt) then
                    Internal.Util.Tween(btn, { BackgroundTransparency = 0.93 }, 0.16)
                end
            end, function()
                if not isSelected(opt) then
                    Internal.Util.Tween(btn, { BackgroundTransparency = 1 }, 0.18)
                end
            end)
        end

        if multi then
            local cleanVals = {}
            for k, v in pairs(entry.Value or {}) do
                if v and optionButtons[k] then
                    cleanVals[k] = true
                end
            end
            entry.Value = cleanVals
        elseif entry.Value ~= nil and not optionButtons[entry.Value] then
            entry.Value = nil
        end

        updateDisplay()
        if expanded then
            toggleList(true)
        end
    end

    Internal.Util.Connect(button.MouseButton1Click, function()
        toggleList(not expanded)
    end)

    Internal.Util.Hover(button, function()
        if not expanded then
            Internal.Util.Tween(uiStroke, { Transparency = 0.05 }, 0.16)
        end
    end, function()
        if not expanded then
            Internal.Util.Tween(uiStroke, { Transparency = 0.25 }, 0.2)
        end
    end)

    entry:SetOptions(options)
    entry:Set(entry.Value, true)

    if config.Callback then
        task.spawn(config.Callback, entry.Value)
    end

    return entry
end

Internal.Components.Keybind = function(parent, config, order)
