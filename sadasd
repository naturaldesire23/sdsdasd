Internal.Util.Font = function(weight)
    weight = weight or Internal.Layout.Weight.Medium
    local cached = Internal.State.FontCache[weight]
    if not cached then
        cached = Font.new(Internal.Layout.FontFamily, weight)
        Internal.State.FontCache[weight] = cached
    end
    return cached
end

Internal.Util.Connect = function(signal, callback)
    local conn = signal:Connect(callback)
    table.insert(Internal.State.Connections, conn)
    return conn
end

Internal.Util.New = function(className, props, children)
    local instance = Instance.new(className)
    local parent = nil
    if props then
        parent = props.Parent
        props.Parent = nil
        for k, v in pairs(props) do
            instance[k] = v
        end
    end
    if children then
        for _, child in ipairs(children) do
            child.Parent = instance
        end
    end
    instance.Parent = parent
    return instance
end

Internal.Util.Tween = function(instance, properties, duration, style, direction)
    local tween = Tween:Create(instance, TweenInfo.new(duration or 0.22, style or Internal.Layout.Ease, direction or Enum.EasingDirection.Out), properties)
    tween:Play()
    return tween
end

Internal.Util.Corner = function(radius)
    local r = typeof(radius) == "UDim" and radius
    if not r then
        r = UDim.new(0, radius or 6)
    end
    return Internal.Util.New("UICorner", { CornerRadius = r })
end

Internal.Util.Stroke = function(colorKey, thickness, transparency)
    local stroke = Internal.Util.New("UIStroke", {
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    })
    Internal.Theme.Bind(stroke, "Color", colorKey or "Border")
    return stroke
end

Internal.Util.Gradient = function(colorResolver, transparency, rotation)
    local grad = Internal.Util.New("UIGradient", {
        Transparency = transparency or NumberSequence.new(0),
        Rotation = rotation or 0,
    })
    if colorResolver then
        Internal.Theme.BindDynamic(grad, "Color", colorResolver)
    end
    return grad
end

Internal.Util.Fade = function(...)
    local points = {}
    local count = select("#", ...)
    for i, v in ipairs({ ... }) do
        points[i] = NumberSequenceKeypoint.new((i - 1) / (count - 1), v)
    end
    return NumberSequence.new(points)
end

