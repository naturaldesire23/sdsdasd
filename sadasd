                return
            end
            obj:SetEnabled(not obj.Enabled)
        end)

        Internal.Util.Hover(header, function()
            if not obj.Enabled then
                Internal.Util.Tween(obj.Stroke, { Color = palette.Muted, Transparency = 0.55 }, 0.09)
            end
            Internal.Util.Tween(titleLabel, { TextColor3 = palette.Text }, 0.18)
        end, function()
            if not obj.Enabled then
                Internal.Util.Tween(obj.Stroke, { Color = palette.Border, Transparency = 0.3 }, 0.22)
                if obj.Toggleable then
                    Internal.Util.Tween(titleLabel, { TextColor3 = palette.SubText }, 0.22)
                end
            end
        end)

        obj:SetEnabled(Internal.State.Saved[obj.Flag] == true, true, true)
        if obj.Enabled and config.Callback then
            task.spawn(config.Callback, true)
        end

        table.insert(tab.Modules, obj)
        return obj
    end

    for k, component in pairs(Internal.Components) do
        moduleMeta[k] = function(self, config)
            config = config or {}
            self.Order = self.Order + 1
            local entry = component(self.Content, config, self.Order)
            if config.Flag then
                ZenthraUI.Options[config.Flag] = entry
            end
            self.Keyword = self.Keyword .. " " .. (config.Title or ""):lower()
            if not self.Expanded then
                self:SetExpanded(true, false)
            end
            return entry
        end
    end

    moduleMeta.Label = function(self, text)
        return self:Paragraph({ Text = type(text) == "table" and text.Text or text })
    end
end

