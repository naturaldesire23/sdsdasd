Internal.Icons.Resolve = function(name)
    if type(name) ~= "string" or name == "" then
        return ""
    end
    if name:match("^rbxassetid://") or name:match("^rbxasset://") then
        return name
    end
    if name:match("^%d+$") then
        return "rbxassetid://" .. name
    end
    return Internal.Icons.Data[name] or ""
end

Internal.Config.Path = function()
    return Internal.Config.Folder .. "/" .. Internal.Config.Name .. ".json"
end

Internal.Config.Setup = function(folder, name)
    if not Env.Filesystem then
        return
    end
    Internal.Config.Folder = folder or "Zenthra"
    Internal.Config.Name = name or "config"
    Internal.Config.Enabled = true
    if not isfolder(Internal.Config.Folder) then
        pcall(makefolder, Internal.Config.Folder)
    end
    ZenthraUI.MediaFolder = Internal.Config.Folder .. "/backgrounds"
    pcall(function()
        if not isfolder(ZenthraUI.MediaFolder) then
            makefolder(ZenthraUI.MediaFolder)
        end
    end)
end

Internal.Config.EncodeValue = function(value)
    if typeof(value) == "Color3" then
        return { __t = "Color3", r = math.floor(value.R * 255 + 0.5), g = math.floor(value.G * 255 + 0.5), b = math.floor(value.B * 255 + 0.5) }
    end
    if typeof(value) == "Enum" or typeof(value) == "EnumItem" then
        return { __t = "Enum", v = tostring(value) }
    end
    return value
end

Internal.Config.DecodeValue = function(value)
    if type(value) == "table" and value.__t == "Color3" then
        return Color3.fromRGB(value.r, value.g, value.b)
    end
    if type(value) == "table" and value.__t == "Enum" then
        local enumType, enumVal = value.v:match("^Enum%.(%w+)%.(%w+)$")
        if enumType and Enum[enumType] then
            local ok, result = pcall(function()
                return Enum[enumType][enumVal]
            end)
            if ok then
                return result
            end
        end
        return nil
    end
    return value
end

Internal.Config.Save = function()
    if not Internal.Config.Enabled then
        return
    end
    local data = {}
    for k, v in pairs(ZenthraUI.Flags) do
        data[k] = Internal.Config.EncodeValue(v)
    end
    pcall(function()
        writefile(Internal.Config.Path(), Http:JSONEncode(data))
    end)
end

Internal.Config.Queue = function()
    if not Internal.Config.Enabled or Internal.Config._queued then
        return
    end
    Internal.Config._queued = true
    task.delay(0.4, function()
        Internal.Config._queued = false
        Internal.Config.Save()
    end)
end

Internal.Config.Load = function()
    if not Internal.Config.Enabled or not isfile(Internal.Config.Path()) then
        return {}
    end
    local ok, result = pcall(function()
        return Http:JSONDecode(readfile(Internal.Config.Path()))
    end)
    if not ok or type(result) ~= "table" then
        return {}
    end
    local data = {}
    for k, v in pairs(result) do
        data[k] = Internal.Config.DecodeValue(v)
    end
    return data
end

Internal.Config.SetFlag = function(flag, value)
    if not flag then
        return
    end
    ZenthraUI.Flags[flag] = value
    Internal.Config.Queue()
end

