        Text = "",
        AutoButtonColor = false,
        Size = UDim2.new(1, 0, 0, 20),
        BackgroundTransparency = 1,
        Parent = pickerArea,
    })

    local rainbowLabel = Internal.Util.Label({
        Text = "Rainbow",
        TextSize = 12,
        ColorKey = "SubText",
        Size = UDim2.new(1, -34, 1, 0),
        Parent = rainbowToggle,
    })

    local rainbowSwitch = Internal.Util.New("Frame", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.fromOffset(28, 15),
        BackgroundTransparency = 0.5,
        BorderSizePixel = 0,
        Parent = rainbowToggle,
    }, { Internal.Util.Corner(UDim.new(1, 0)), Internal.Util.Stroke("Border", 1, 0.2) })
    Internal.Theme.Bind(rainbowSwitch, "BackgroundColor3", "Surface")

    local rainbowKnob = Internal.Util.New("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 3, 0.5, 0),
        Size = UDim2.fromOffset(9, 9),
        BorderSizePixel = 0,
        Parent = rainbowSwitch,
    }, { Internal.Util.Corner(UDim.new(1, 0)) })
    Internal.Theme.Bind(rainbowKnob, "BackgroundColor3", "Muted")

    local expanded = false
    local isRainbow = false
    local rainbowConn
    local entry = { Type = "Colorpicker", Value = default, Root = root }

    local function updateColor(silent)
        local color = Color3.fromHSV(h, s, v)
        entry.Value = color
        preview.BackgroundColor3 = color
        sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        local knob = sv:FindFirstChild("Frame", true)
        if knob then
            knob.Position = UDim2.new(s, 0, 1 - v, 0)
        end
        local hueKnob = hueBar:FindFirstChild("Frame")
        if hueKnob then
            hueKnob.Position = UDim2.new(h, 0, 0.5, 0)
        end
        hexBox.Text = string.format("#%02X%02X%02X", math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5))
        if config.Flag then
            ZenthraUI.Flags[config.Flag] = color
            if not silent then
                Internal.Config.Queue()
            end
        end
        if not silent and config.Callback then
            task.spawn(config.Callback, color)
        end
    end

    entry.SetRainbow = function(_, state)
        local newState = state == true
        if newState == isRainbow then
            return
        end
        isRainbow = newState
        Internal.Config.SetFlag((config.Flag or "") .. "__rainbow", newState)

        Internal.Util.Tween(rainbowSwitch, {
            BackgroundColor3 = isRainbow and palette.Accent or palette.Surface,
            BackgroundTransparency = isRainbow and 0.06 or 0.5,
        }, 0.24)

        Internal.Util.Tween(rainbowKnob, {
            Position = isRainbow and UDim2.new(1, -12, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
            BackgroundColor3 = isRainbow and palette.Background or palette.Muted,
        }, 0.24)

        Internal.Util.Tween(rainbowLabel, { TextColor3 = isRainbow and palette.Text or palette.SubText }, 0.24)

        if rainbowConn then
            rainbowConn:Disconnect()
            rainbowConn = nil
        end

        if isRainbow then
            s = 1
            v = 1
            rainbowConn = Internal.Util.Connect(Run.RenderStepped, function(dt)
                h = (h + dt * (config.RainbowSpeed or 0.15)) % 1
                updateColor(false, true)
            end)
        else
            Internal.Config.Queue()
        end
    end

    entry.Set = function(_, color, silent)
        if typeof(color) ~= "Color3" then
            return
        end
        entry:SetRainbow(false)
        local nh, ns, nv = color:ToHSV()
        h, s, v = nh, ns, nv
        updateColor(silent)
    end

    entry.Get = function()
        return entry.Value
    end

    Internal.Util.Connect(rainbowToggle.MouseButton1Click, function()
        entry:SetRainbow(not isRainbow)
    end)

    local function toggleExpand(state)
        expanded = state
        Internal.Util.Tween(container, { Size = UDim2.new(1, 0, 0, expanded and 167 or 0) }, 0.3)
    end

    Internal.Util.Connect(header.MouseButton1Click, function()
        toggleExpand(not expanded)
    end)

    Internal.Util.Hover(header, function()
        Internal.Util.Tween(label, { TextColor3 = palette.Text }, 0.16)
    end, function()
        Internal.Util.Tween(label, { TextColor3 = palette.SubText }, 0.2)
    end)

    local function handleDrag(frame, callback)
        local dragging = false
        Internal.Util.Connect(frame.InputBegan, function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end
            dragging = true
            Internal.Window.BlockDrag = true
            callback(input.Position)
        end)
        Internal.Util.Connect(UserInput.InputChanged, function(input)
            if not dragging then
                return
            end
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                callback(input.Position)
            end
        end)
        Internal.Util.Connect(UserInput.InputEnded, function(input)
            if not dragging then
                return
            end
            if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end
            dragging = false
            Internal.Window.BlockDrag = false
            Internal.Config.Queue()
        end)
    end

    handleDrag(sv, function(pos)
        entry:SetRainbow(false)
        local size = sv.AbsoluteSize
        local origin = sv.AbsolutePosition
        s = math.clamp((pos.X - origin.X) / math.max(size.X, 1), 0, 1)
        v = 1 - math.clamp((pos.Y - origin.Y) / math.max(size.Y, 1), 0, 1)
        updateColor()
    end)

    handleDrag(hueBar, function(pos)
        entry:SetRainbow(false)
        h = math.clamp((pos.X - hueBar.AbsolutePosition.X) / math.max(hueBar.AbsoluteSize.X, 1), 0, 1)
        updateColor()
    end)

    Internal.Util.Connect(hexBox.FocusLost, function()
        local hex = hexBox.Text:gsub("#", "")
        if #hex == 6 and tonumber(hex, 16) then
            entry:Set(Color3.fromHex(hex))
        else
            updateColor(true)
        end
    end)

    updateColor(true)
    local rainbow = config.Rainbow
    if not rainbow and Internal.State.Saved[(config.Flag or "") .. "__rainbow"] == true then
        rainbow = true
    end
    if rainbow then
        entry:SetRainbow(true)
    end

    if config.Callback then
        task.spawn(config.Callback, entry.Value)
    end

    return entry
end

