    Internal.Util.Connect(searchBox:GetPropertyChangedSignal("Text"), function()
        local query = searchBox.Text:lower():gsub("^%s+", ""):gsub("%s+$", "")
        local hasQuery = query ~= ""
        local order = 0

        for _, tab in ipairs(window.Tabs) do
            for _, mod in ipairs(tab.Modules) do
                local match = hasQuery and mod.Keyword:find(query, 1, true) ~= nil
                local col = mod.Column
                if match then
                    order = order + 1
                    mod.Frame.LayoutOrder = order
                    col = order % 2 == 1 and searchLeft or searchRight
                else
                    mod.Frame.LayoutOrder = mod.LayoutOrder
                end
                if mod.Frame.Parent ~= col then
                    mod.Frame.Parent = col
                end
            end
        end

        noResults.Visible = hasQuery and order == 0
        if hasQuery == isSearching then
            return
        end
        isSearching = hasQuery

        if hasQuery then
            if window.ActiveTab then
                window.ActiveTab.Page.Visible = false
            end
            searchPage.Visible = true
            searchPage.GroupTransparency = 1
            Internal.Util.Tween(searchPage, { GroupTransparency = 0 }, 0.28)
